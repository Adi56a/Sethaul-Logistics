# SetuHaul Logistics — Environment Configuration Template
# Copy this file to .env and populate with your credentials

# Database Configuration
DATABASE_PATH=setuhaul_freight_operations.db
DATABASE_TIMEOUT_MS=5000
TIMEZONE=Asia/Kolkata

# Application & API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Operational Rules
HOLD_TTL_MINUTES=15
CHECKIN_GRACE_MINUTES=30
LAST_ALLOWED_START_TIME=21:00

# LLM Provider Configuration (OpenRouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Fallbacks
OPENAI_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=setuhaul-agent
